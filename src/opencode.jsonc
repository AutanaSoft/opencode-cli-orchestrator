{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "AutanaSoft",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"]
      },
      "engram": {
        "type": "local",
        "command": ["/home/lcardenas/.local/bin/engram", "mcp", "--tools=agent"]
      }
    }
  },
  "instructions": ["./instructions/engram.md"]
}
