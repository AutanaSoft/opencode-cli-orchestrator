{
  "name": "opencode-cli-orchestrator",
  "displayName": "OpenCode Orchestrator",
  "version": "0.1.0",
  "description": "Hybrid OpenCode orchestration configuration with specialized agents and optional task templates.",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "AutanaSoft",
    "email": "admin@autanasoft.com",
    "url": "https://autanasoft.com"
  },
  "homepage": "https://github.com/AutanaSoft/opencode-cli-orchestrator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AutanaSoft/opencode-cli-orchestrator.git"
  },
  "bugs": {
    "url": "https://github.com/AutanaSoft/opencode-cli-orchestrator/issues"
  },
  "keywords": [
    "opencode",
    "orchestration",
    "ai-agents",
    "developer-tools"
  ],
  "type": "module",
  "scripts": {
    "install:opencode": "node scripts/install.mjs",
    "install:opencode:check": "node scripts/install.mjs --dry-run",
    "check": "pnpm format:check && pnpm test",
    "test": "node --test",
    "format": "prettier --write . && pnpm lint:md",
    "format:check": "prettier --check . && pnpm lint:md",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
